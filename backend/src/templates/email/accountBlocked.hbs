<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f4f7f4; }
    .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #c62828, #e53935); padding: 32px 24px; text-align: center; }
    .header h1 { color: #fff; margin: 0; font-size: 24px; }
    .body { padding: 32px 24px; color: #333; line-height: 1.6; }
    .body h2 { color: #c62828; margin-top: 0; }
    .alert-box { background: #ffebee; border: 2px solid #ef5350; padding: 20px; border-radius: 8px; margin: 20px 0; }
    .footer { background: #f5f5f5; padding: 20px 24px; text-align: center; font-size: 12px; color: #888; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>⚠️ Account {{action}}</h1>
    </div>
    <div class="body">
      <h2>Hi {{name}},</h2>
      {{#if isBlocked}}
      <div class="alert-box">
        <p>Your Green Basket account has been <strong>suspended</strong>.</p>
        {{#if reason}}<p><strong>Reason:</strong> {{reason}}</p>{{/if}}
      </div>
      <p>While your account is suspended, you will not be able to access certain features. If you believe this is a mistake, please contact our support team.</p>
      {{else}}
      <p>Great news! Your Green Basket account has been <strong>reactivated</strong>. You can now access all features as usual.</p>
      {{/if}}
    </div>
    <div class="footer">
      <p>© {{year}} Green Basket. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
