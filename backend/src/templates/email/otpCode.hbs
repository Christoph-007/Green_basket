<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f4f7f4; }
    .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #2e7d32, #43a047); padding: 32px 24px; text-align: center; }
    .header h1 { color: #fff; margin: 0; font-size: 24px; }
    .body { padding: 32px 24px; color: #333; line-height: 1.6; }
    .body h2 { color: #2e7d32; margin-top: 0; }
    .otp-box { background: #e8f5e9; border: 2px dashed #2e7d32; padding: 24px; text-align: center; border-radius: 8px; margin: 24px 0; }
    .otp-code { font-size: 36px; letter-spacing: 8px; font-weight: 700; color: #2e7d32; margin: 0; }
    .timer { color: #888; font-size: 13px; margin-top: 8px; }
    .footer { background: #f5f5f5; padding: 20px 24px; text-align: center; font-size: 12px; color: #888; }
    .warning { color: #d32f2f; font-size: 13px; margin-top: 16px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>{{#if isVerification}}✉️ Verify your email{{else}}🔐 Password Reset{{/if}}</h1>
    </div>
    <div class="body">
      <h2>Hi {{name}},</h2>
      <p>{{#if isVerification}}Welcome to Green Basket! Use the code below to verify your email address:{{else}}We received a request to reset your password. Use the OTP below to proceed:{{/if}}</p>
      <div class="otp-box">
        <p class="otp-code">{{otp}}</p>
        <p class="timer">⏱ This code expires in <strong>10 minutes</strong></p>
      </div>
      <p>{{#if isVerification}}Enter this code in the app to finish creating your account.{{else}}Enter this code in the app to set a new password.{{/if}}</p>
      <p class="warning">⚠️ {{#if isVerification}}If you did not create a Green Basket account, you can ignore this email.{{else}}If you did not request a password reset, please ignore this email and ensure your account is secure.{{/if}}</p>
    </div>
    <div class="footer">
      <p>© {{year}} Green Basket. All rights reserved.</p>
      <p>This is an automated message — do not reply.</p>
    </div>
  </div>
</body>
</html>
