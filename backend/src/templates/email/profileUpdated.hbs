<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f4f7f4; }
    .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #2e7d32, #43a047); padding: 32px 24px; text-align: center; }
    .header h1 { color: #fff; margin: 0; font-size: 24px; }
    .body { padding: 32px 24px; color: #333; line-height: 1.6; }
    .body h2 { color: #2e7d32; margin-top: 0; }
    .info-box { background: #e8f5e9; padding: 16px; border-radius: 8px; margin: 16px 0; }
    .footer { background: #f5f5f5; padding: 20px 24px; text-align: center; font-size: 12px; color: #888; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>👤 Profile Updated</h1>
    </div>
    <div class="body">
      <h2>Hi {{name}},</h2>
      <p>Your profile has been successfully updated.</p>
      <div class="info-box">
        <strong>Changes made:</strong>
        <p>{{changes}}</p>
      </div>
      <p>If you did not make these changes, please secure your account immediately by changing your password.</p>
    </div>
    <div class="footer">
      <p>© {{year}} Green Basket. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
