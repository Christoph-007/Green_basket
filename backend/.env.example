# Environment Configuration
NODE_ENV=development
PORT=5002

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/greenbasket?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=30d

# Delivery Agent JWT (separate secret for agent tokens)
AGENT_JWT_SECRET=your-agent-jwt-secret-change-in-production

# Frontend URL
FRONTEND_URL=http://localhost:3000
# Browser origins allowed by CORS (comma-separated). The mobile app needs no entry.
# If empty, FRONTEND_URL is used; in production with neither, browsers are blocked.
CORS_ORIGINS=http://localhost:3000

# Cloudinary Configuration (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration — SendGrid (https://app.sendgrid.com)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@greenbasket.com
EMAIL_FROM_NAME=GreenBasket

# Email Fallback — Gmail SMTP (used if SendGrid not configured)
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-digit-app-password

# Razorpay (https://dashboard.razorpay.com -> Account & Settings -> API Keys)
# REQUIRED: the server will not start without KEY_ID (src/config/razorpay.js).
# Use test keys (rzp_test_...) for development, live keys (rzp_live_...) for production.
KEY_ID=rzp_test_xxxxxxxxxxxxxx
KEY_SECRET=your_razorpay_key_secret
# Webhook (Razorpay dashboard → Webhooks): URL https://<your-server>/api/payment/webhook,
# events payment.captured, order.paid, payment.failed; paste the same secret here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Unpaid online orders are cancelled (stock released) after this many minutes
PAYMENT_PENDING_TIMEOUT_MINUTES=30

# Twilio SMS (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Firebase Push Notifications (https://console.firebase.google.com -> Project Settings -> Service Accounts)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Redis (optional — used for caching & rate limiting)

# Dev scripts (verify_route.js) — admin JWT from POST /api/auth/admin/login
ADMIN_TEST_TOKEN=
